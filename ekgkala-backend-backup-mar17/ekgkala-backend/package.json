{
  "name": "ekgkala-backend",
  "version": "1.0.0",
  "description": "Backend API for EkgKala E-commerce Admin Panel",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node seedAdmin.js",
    "migrate:slugs": "node scripts/generate-all-slugs.js",
    "migrate:slugs:dry": "node scripts/generate-all-slugs.js --dry-run --verbose",
    "migrate:product-slugs": "node scripts/generate-product-slugs.js",
    "migrate:category-slugs": "node scripts/generate-category-slugs.js",
    "migrate:product-codes": "node scripts/generate-product-codes.js",
    "migrate:product-codes:dry": "node scripts/generate-product-codes.js --dry-run --verbose",
    "migrate:all": "npm run migrate:slugs && npm run migrate:product-codes",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "ekgkala",
    "ecommerce",
    "backend",
    "api",
    "express",
    "mongodb"
  ],
  "author": "EkgKala Team",
  "license": "ISC",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "axios": "^1.13.5",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.8.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "csv-parser": "^3.2.0",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.2.1",
    "express-validator": "^7.3.1",
    "google-auth-library": "^10.5.0",
    "groq-sdk": "^0.37.0",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "ioredis": "^5.8.2",
    "joi": "^18.0.2",
    "jsonwebtoken": "^9.0.2",
    "kavenegar": "^1.1.4",
    "mongoose": "^7.5.0",
    "multer": "^1.4.5-lts.1",
    "node-cache": "^5.1.2",
    "nodemailer": "^7.0.10",
    "resend": "^6.6.0",
    "socks": "^2.8.7",
    "socks-proxy-agent": "^8.0.5",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "overrides": {
    "minimatch": "10.2.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
