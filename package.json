{
  "name": "ekgkala-store-monorepo",
  "version": "1.0.0",
  "description": "EkgKala Store - E-commerce Platform",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "postinstall": "pnpm run install:all",
    "install:all": "pnpm run install:backend && pnpm run install:frontend && pnpm run install:admin",
    "install:backend": "pnpm --dir ekgkala-backend install --prod=false",
    "install:frontend": "pnpm --dir frontend install --prod=false",
    "install:admin": "pnpm --dir admin install --prod=false",
    "install:ci": "pnpm --dir ekgkala-backend install --frozen-lockfile --prefer-offline --prod=false && pnpm --dir frontend install --frozen-lockfile --prefer-offline --prod=false && pnpm --dir admin install --frozen-lockfile --prefer-offline --prod=false",
    "dev": "pnpm run dev:backend & pnpm run dev:frontend & pnpm run dev:admin",
    "dev:backend": "pnpm --dir ekgkala-backend run dev",
    "dev:frontend": "pnpm --dir frontend run dev",
    "dev:admin": "pnpm --dir admin run dev",
    "start": "pnpm run start:backend & pnpm run start:frontend & pnpm run start:admin",
    "start:backend": "pnpm --dir ekgkala-backend run start",
    "start:frontend": "pnpm --dir frontend run start",
    "start:admin": "pnpm --dir admin run preview --port 3001",
    "build": "pnpm run build:frontend && pnpm run build:admin",
    "build:frontend": "pnpm --dir frontend run build",
    "build:admin": "pnpm --dir admin run build",
    "lint": "pnpm run lint:frontend",
    "lint:frontend": "pnpm --dir frontend run lint",
    "typecheck": "pnpm run typecheck:frontend",
    "typecheck:frontend": "pnpm --dir frontend run typecheck",
    "test": "pnpm run test:backend && pnpm run test:frontend",
    "test:backend": "pnpm --dir ekgkala-backend run test",
    "test:frontend": "pnpm --dir frontend run test",
    "clean": "node -e \"const fs=require('fs'); ['ekgkala-backend/node_modules','frontend/node_modules','admin/node_modules'].forEach(p=>fs.rmSync(p,{recursive:true,force:true}))\"",
    "clean:backend": "node -e \"require('fs').rmSync('ekgkala-backend/node_modules',{recursive:true,force:true})\"",
    "clean:frontend": "node -e \"require('fs').rmSync('frontend/node_modules',{recursive:true,force:true})\"",
    "clean:admin": "node -e \"require('fs').rmSync('admin/node_modules',{recursive:true,force:true})\"",
    "audit:all": "pnpm run audit:backend && pnpm run audit:frontend && pnpm run audit:admin",
    "audit:backend": "pnpm --dir ekgkala-backend audit",
    "audit:frontend": "pnpm --dir frontend audit",
    "audit:admin": "pnpm --dir admin audit"
  },
  "keywords": [
    "ecommerce",
    "react",
    "nextjs",
    "nodejs",
    "express",
    "mongodb",
    "typescript"
  ],
  "author": "EkgKala Team",
  "license": "MIT"
}
