{
  "name": "ekgkala-store-monorepo",
  "version": "1.0.0",
  "description": "EkgKala Store - E-commerce Platform",
  "private": true,
  "scripts": {
    "install:all": "npm run install:backend && npm run install:frontend && npm run install:admin",
    "install:backend": "cd ekgkala-backend && npm ci --include=dev",
    "install:frontend": "cd frontend && npm ci --include=dev",
    "install:admin": "cd admin && npm ci --include=dev",
    "dev": "npm run dev:backend & npm run dev:frontend & npm run dev:admin",
    "dev:backend": "cd ekgkala-backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:admin": "cd admin && npm run dev",
    "start": "npm run start:backend & npm run start:frontend & npm run start:admin",
    "start:backend": "cd ekgkala-backend && npm start",
    "start:frontend": "cd frontend && npm start",
    "start:admin": "cd admin && npm start",
    "build": "npm run build:frontend && npm run build:admin",
    "build:frontend": "cd frontend && npm run build",
    "build:admin": "cd admin && npm run build",
    "lint": "npm run lint:frontend",
    "lint:frontend": "cd frontend && npm run lint",
    "typecheck": "npm run typecheck:frontend",
    "typecheck:frontend": "cd frontend && npm run typecheck",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "cd ekgkala-backend && npm test",
    "test:frontend": "cd frontend && npm test",
    "setup": "./setup.sh",
    "clean": "npm run clean:backend && npm run clean:frontend && npm run clean:admin",
    "clean:backend": "cd ekgkala-backend && rm -rf node_modules",
    "clean:frontend": "cd frontend && rm -rf node_modules",
    "clean:admin": "cd admin && rm -rf node_modules",
    "audit:all": "npm run audit:backend && npm run audit:frontend && npm run audit:admin",
    "audit:backend": "cd ekgkala-backend && npm audit",
    "audit:frontend": "cd frontend && npm audit",
    "audit:admin": "cd admin && npm audit"
  },
  "keywords": [
    "ecommerce",
    "react",
    "nextjs",
    "nodejs",
    "express",
    "mongodb",
    "typescript"
  ],
  "author": "EkgKala Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "overrides": {
    "cross-spawn": "^7.0.6",
    "shell-quote": "^1.8.5"
  }
}
