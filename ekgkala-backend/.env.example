# ====================================
# PRODUCTION - VPS
# ====================================

# --- Application Settings ---
NODE_ENV=production
PORT=5000

# --- MongoDB (Local Docker) ---
MONGODB_URI=mongodb://CHANGE_ME:CHANGE_ME@localhost:27017/ekgkala

# --- JWT Authentication ---
JWT_SECRET=CHANGE_ME
JWT_AUDIENCE=CHANGE_ME
JWT_COOKIE_MAX_AGE=604800000
JWT_EXPIRES_IN=7d
JWT_ISSUER=welfvita-api

# --- Admin Setup ---
ADMIN_EMAIL=welfvita@gmail.com
ADMIN_SETUP_KEY=CHANGE_ME

# --- URLs (   ) ---
ADMIN_URL=https://admin.ekgkala.ir
CLIENT_URL=https://www.ekgkala.ir,https://admin.ekgkala.ir
FRONTEND_URL=https://www.ekgkala.ir
CORS_ALLOWED_ORIGINS=https://www.ekgkala.ir,https://admin.ekgkala.ir
BASE_URL=https://www.ekgkala.ir

# --- Google OAuth ---
GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com

# PARSPACK CLOUD STORAGE CONFIG
PARSPACK_ENDPOINT=c258565.parspack.net
PARSPACK_BUCKET_NAME=ekgkala-uploads
PARSPACK_ACCESS_KEY=CHANGE_ME
PARSPACK_SECRET_KEY=CHANGE_ME
PARSPACK_REGION=default
UPLOAD_BASE_PATH=/var/www/ekgkala/uploads
UPLOAD_BASE_URL=https://www.ekgkala.ir/uploads
UPLOAD_MAX_FILE_SIZE_MB=10

# --- Email (Resend) ---
EMAIL_FROM_NAME=EkgKala Store
RESEND_API_KEY=CHANGE_ME
RESEND_FROM_EMAIL=onboarding@resend.dev

# --- Payment (Zarinpal) ---
ZARINPAL_MERCHANT_ID=CHANGE_ME
ZARINPAL_SANDBOX=false

# --- Kavenegar SMS ---
KAVENEGAR_API_KEY=CHANGE_YOUR_KAVENEGAR_API_KEY
KAVENEGAR_SENDER=CHANGE_ME

# --- Redis (  -   ) ---
REDIS_URL=redis://localhost:6379

# --- Debug ---
DEBUG_CONSOLE=false

# --- Melipayamak SMS ---
MELIPAYAMAK_OTP_BODY_ID=434916
MELIPAYAMAK_API_KEY=CHANGE_ME

# --- Anti-Abuse & Security Controls ---
OTP_SMS_DISABLED=false
OTP_SITE_WIDE_HOURLY_CAP=80
CAPTCHA_TTL_SECONDS=120

# --- Torob API V3 (obtain the public key and token version from Torob) ---
TOROB_PUBLIC_KEY=
TOROB_TOKEN_VERSION=1
TOROB_FEED_CACHE_TTL_SECONDS=600

# --- Competitive pricing exact-floor freshness (days) ---
# MANAGED_EXACT_FLOOR_MAX_AGE_DAYS=14
