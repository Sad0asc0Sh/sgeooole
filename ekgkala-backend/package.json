{
  "name": "ekgkala-backend",
  "version": "1.0.0",
  "description": "Backend API for EkgKala E-commerce Admin Panel",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node seedAdmin.js",
    "migrate:slugs": "node scripts/generate-all-slugs.js",
    "migrate:slugs:dry": "node scripts/generate-all-slugs.js --dry-run --verbose",
    "migrate:product-slugs": "node scripts/generate-product-slugs.js",
    "migrate:category-slugs": "node scripts/generate-category-slugs.js",
    "migrate:product-codes": "node scripts/generate-product-codes.js",
    "migrate:product-codes:dry": "node scripts/generate-product-codes.js --dry-run --verbose",
    "migrate:all": "npm run migrate:slugs && npm run migrate:product-codes",
    "test": "node tests/chat-architecture.test.cjs && node tests/cart-pricing.test.cjs && node tests/torob-api-v3.test.js",
    "test:torob-acceptance": "node tests/torob-acceptance.js"
  },
  "keywords": [
    "ekgkala",
    "ecommerce",
    "backend",
    "api",
    "express",
    "mongodb"
  ],
  "author": "EkgKala Team",
  "license": "ISC",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "axios": "^1.19.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "csv-parser": "^3.2.0",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.6.1",
    "express-validator": "^7.3.1",
    "google-auth-library": "^10.9.1",
    "groq-sdk": "^1.5.0",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "ioredis": "^5.11.1",
    "joi": "^18.2.0",
    "jsonwebtoken": "^9.0.2",
    "kavenegar": "^1.1.4",
    "mongoose": "^7.8.11",
    "multer": "^2.1.1",
    "node-cache": "^5.1.2",
    "nodemailer": "^9.0.3",
    "resend": "^6.18.1",
    "socks": "^2.8.7",
    "socks-proxy-agent": "^8.0.5",
    "svg-captcha": "^1.4.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.10"
  },
  "overrides": {
    "axios": "^1.19.0",
    "body-parser": "^1.20.3",
    "form-data": "^4.0.6",
    "ip-address": "^10.1.1",
    "lodash": "^4.18.1",
    "minimatch": "10.2.3",
    "nodemailer": "^9.0.3",
    "picomatch": "^2.3.2",
    "tmp": "^0.2.6",
    "uuid": "^13.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
