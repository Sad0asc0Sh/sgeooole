{
  "browser": {
    "mode": "launch",
    "executable_path": "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe",
    "headless": true
  },
  "environment": {
    "viewport": { "width": 1440, "height": 900, "device_scale_factor": 1 },
    "locale": "fa-IR",
    "timezone": "Asia/Tehran",
    "color_scheme": "light",
    "reduced_motion": "reduce",
    "service_workers": "block"
  },
  "start_url": { "url": "https://www.technolife.com/product/list/69_771_112" },
  "actions": [
    { "step_id": "settle", "action": "wait_for_timeout", "duration_ms": 6000 },
    { "step_id": "dom-ready", "action": "wait_for", "locator": { "kind": "css", "selector": "body" }, "state": "visible", "timeout_ms": 20000 }
  ],
  "capture": {
    "at_end": ["dom", "accessibility", "url", "screenshot"],
    "events": ["network", "console", "page-errors"],
    "network": { "response_body": true, "header_values": false, "request_body": false }
  }
}
