# ═══════════════════════════════════════════════════════════════════════════════
# 🔐 WELFVITA BACKEND - Environment Variables
# ═══════════════════════════════════════════════════════════════════════════════
# این فایل نمونه است. برای دیپلوی:
# 1. در Render Dashboard: Environment → Environment Variables
# 2. هر خط را به صورت Key=Value اضافه کنید
# 3. Secret values را با دستور: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ═══════════════════════════════════════════════════════════════════════════════

# =============================================================================
# 🌐 APPLICATION
# =============================================================================
NODE_ENV=production
PORT=5000

# =============================================================================
# 🗄️ DATABASE (MongoDB Atlas)
# =============================================================================
# Format: mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority
# ⚠️ از MongoDB Atlas Free Tier استفاده کنید
MONGODB_URI=mongodb+srv://CHANGE_USERNAME:CHANGE_PASSWORD@cluster0.xxxxx.mongodb.net/welfvita?retryWrites=true&w=majority

# =============================================================================
# 🔑 JWT & AUTHENTICATION
# =============================================================================
# تولید: node scripts/generate-env-secrets.js
JWT_SECRET=CHANGE_THIS_TO_64_CHAR_RANDOM_HEX_STRING
JWT_EXPIRES_IN=7d
JWT_ISSUER=welfvita-api
JWT_AUDIENCE=welfvita-clients

# JWT برای مشتریان (Optional - اگر متفاوت باشد)
JWT_EXPIRE_CUSTOMER=7d
JWT_COOKIE_MAX_AGE=604800000

# =============================================================================
# 👤 ADMIN SETUP (/api/admin/setup)
# =============================================================================
# تولید: node scripts/generate-env-secrets.js
ADMIN_SETUP_KEY=CHANGE_THIS_TO_32_CHAR_RANDOM_HEX_STRING

# تنظیمات اختیاری ادمین اولیه
ADMIN_EMAIL=admin@welfvita.com
ADMIN_NAME=مدیر سیستم
# ADMIN_PASSWORD=SecurePassword123!

# =============================================================================
# � EMAIL (SMTP)
# =============================================================================
# برای ارسال ایمیل‌های بازنشانی رمز و تاییدیه
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=CHANGE_YOUR_EMAIL@gmail.com
EMAIL_PASS=CHANGE_YOUR_APP_PASSWORD
EMAIL_SECURE=false
EMAIL_FROM_NAME=Welfvita
FROM_EMAIL=noreply@welfvita.com

# اگر نیاز به Proxy دارید (برای Iran)
# EMAIL_PROXY_HOST=
# EMAIL_PROXY_PORT=

# =============================================================================
# ☁️ CLOUDINARY (Image Upload)
# =============================================================================
# از Cloudinary Dashboard دریافت کنید
CLOUDINARY_CLOUD_NAME=CHANGE_YOUR_CLOUD_NAME
CLOUDINARY_API_KEY=CHANGE_YOUR_API_KEY
CLOUDINARY_API_SECRET=CHANGE_YOUR_API_SECRET

# =============================================================================
# 💳 PAYMENT GATEWAY (ZarinPal)
# =============================================================================
ZARINPAL_MERCHANT_ID=XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX
# ⚠️ در production حتماً false باشد
ZARINPAL_SANDBOX=false

# =============================================================================
# 📱 SMS (Kavenegar)
# =============================================================================
KAVENEGAR_API_KEY=CHANGE_YOUR_KAVENEGAR_API_KEY
KAVENEGAR_SENDER=CHANGE_YOUR_10_DIGIT_NUMBER

# =============================================================================
# � REDIS (Optional - Upstash Redis Free)
# =============================================================================
# اگر از Upstash استفاده می‌کنید
REDIS_URL=redis://default:CHANGE_PASSWORD@CHANGE_ENDPOINT:6379
# یا
# REDIS_HOST=CHANGE_ENDPOINT
# REDIS_PORT=6379
# REDIS_PASSWORD=CHANGE_PASSWORD
# REDIS_TLS=true

# =============================================================================
# 🌐 CORS & URLs
# =============================================================================
# دامنه‌های Frontend و Admin از Vercel
CLIENT_URL=https://your-domain.vercel.app
FRONTEND_URL=https://your-domain.vercel.app
ADMIN_URL=https://admin-your-domain.vercel.app

# لیست کامل دامنه‌های مجاز (comma-separated)
CORS_ALLOWED_ORIGINS=https://your-domain.vercel.app,https://admin-your-domain.vercel.app

# =============================================================================
# � LOGGING
# =============================================================================
# Production: warn برای کاهش حجم لاگ
LOG_LEVEL=warn

# فقط برای debug (NOT recommended in production)
DEBUG_CONSOLE=false
LOG_LEGACY=false

# =============================================================================
# � SECURITY & INTEGRATIONS
# =============================================================================
# Google OAuth (اگر استفاده می‌شود)
GOOGLE_CLIENT_ID=CHANGE_IF_USING_GOOGLE_LOGIN

# AI Integration (اگر استفاده می‌شود)
# GROQ_API_KEY=
# AI_API_KEY=
# AI_BASE_URL=
# AI_MODEL=

# KYC Services (اگر استفاده می‌شود)
# KYC_API_KEY=
# FINNOTECH_CLIENT_ID=
# FINNOTECH_CLIENT_SECRET=

# =============================================================================
# � RENDER SPECIFIC
# =============================================================================
# این متغیرها را Render خودکار set می‌کند
# RENDER=true
# RENDER_SERVICE_NAME=welfvita-backend
# RENDER_EXTERNAL_URL=https://welfvita-backend.onrender.com
