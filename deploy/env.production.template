# ═══════════════════════════════════════════════════════════════════════════════
# 🔐 WELFVITA BACKEND - Production Environment Template
# ═══════════════════════════════════════════════════════════════════════════════
# 
# این فایل تنظیمات production است.
# 
# نحوه استفاده:
# 1. این فایل را کپی کنید به backend:
#    cp deploy/env.production.template welfvita-backend/.env
# 2. مقادیر "CHANGE_THIS_..." را با مقادیر واقعی جایگزین کنید
# 3. فایل را امن کنید: chmod 600 welfvita-backend/.env
#
# ⚠️ هرگز فایل .env را در git commit نکنید!
# ═══════════════════════════════════════════════════════════════════════════════

# =============================================================================
# 🌐 APPLICATION
# =============================================================================
NODE_ENV=production
PORT=5000

# =============================================================================
# 🗄️ DATABASE (MongoDB)
# =============================================================================
# ⚠️ مهم: برای production از MongoDB با Authentication استفاده کنید
# ⚠️ مهم: MongoDB باید فقط روی 127.0.0.1 bind شده باشد
#
# Format: mongodb://USERNAME:PASSWORD@HOST:PORT/DATABASE?authSource=DATABASE
#
# مثال برای local MongoDB با auth:
MONGODB_URI=mongodb://welfvita_app:CHANGE_THIS_STRONG_DB_PASSWORD@127.0.0.1:27017/welfvita?authSource=welfvita
#
# مثال برای MongoDB Atlas:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/welfvita?retryWrites=true&w=majority

# =============================================================================
# 🔑 JWT & AUTHENTICATION
# =============================================================================
# ⚠️ حتماً این مقادیر را تغییر دهید!
# تولید secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_A_64_CHAR_RANDOM_STRING_GENERATED_BY_COMMAND_ABOVE
JWT_EXPIRES_IN=7d
JWT_ISSUER=welfvita-api
JWT_AUDIENCE=welfvita-clients

# =============================================================================
# 👤 ADMIN SETUP (/api/admin/setup)
# =============================================================================
# تولید key: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SETUP_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_SETUP_KEY

# =============================================================================
# 📧 EMAIL - Resend API (✅ توصیه شده برای Railway/Render/Vercel)
# =============================================================================
# Resend از HTTP API استفاده می‌کند و مشکل SMTP Timeout ندارد
# ثبت‌نام رایگان: https://resend.com (3000 ایمیل/ماه رایگان)
#
# قدم‌ها:
# 1. ثبت‌نام در resend.com
# 2. ساخت API Key در Dashboard > API Keys
# 3. (اختیاری) تایید دامنه برای ارسال با ایمیل سفارشی
#
RESEND_API_KEY=re_CHANGE_THIS_YOUR_RESEND_API_KEY
# برای تست: onboarding@resend.dev
# بعد از تایید دامنه: noreply@your-domain.com
RESEND_FROM_EMAIL=onboarding@resend.dev

# =============================================================================
# 📧 EMAIL - SMTP (⚠️ Fallback - ممکن است در کلود کار نکند)
# =============================================================================
# ⚠️ SMTP در Railway/Render Free Tier معمولاً Timeout می‌دهد
# فقط اگر Resend کار نکرد، این‌ها استفاده می‌شوند
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=CHANGE_THIS_to_your_email@gmail.com
EMAIL_PASS=CHANGE_THIS_to_your_app_password
EMAIL_SECURE=false
EMAIL_FROM_NAME=ویلف ویتا

# =============================================================================
# ☁️ CLOUDINARY (Image Upload)
# =============================================================================
CLOUDINARY_CLOUD_NAME=CHANGE_THIS_CLOUD_NAME
CLOUDINARY_API_KEY=CHANGE_THIS_API_KEY
CLOUDINARY_API_SECRET=CHANGE_THIS_API_SECRET

# =============================================================================
# 💳 PAYMENT GATEWAY (ZarinPal)
# =============================================================================
ZARINPAL_MERCHANT_ID=CHANGE_THIS_MERCHANT_ID
# ⚠️ در production حتماً false باشد!
ZARINPAL_SANDBOX=false

# =============================================================================
# 📱 KAVENEGAR SMS
# =============================================================================
KAVENEGAR_API_KEY=CHANGE_THIS_KAVENEGAR_API_KEY
KAVENEGAR_SENDER=CHANGE_THIS_SENDER_NUMBER

# =============================================================================
# 🔄 REDIS (Session/Cache)
# =============================================================================
REDIS_URL=redis://127.0.0.1:6379

# =============================================================================
# 🌐 CORS - Allowed Origins
# =============================================================================
# دامنه‌های مجاز برای درخواست‌های API
# ⚠️ حتماً با https شروع شود
CLIENT_URL=https://CHANGE_THIS_YOUR_DOMAIN.com
FRONTEND_URL=https://CHANGE_THIS_YOUR_DOMAIN.com
ADMIN_URL=https://admin.CHANGE_THIS_YOUR_DOMAIN.com

# =============================================================================
# 📝 LOGGING
# =============================================================================
# Production: استفاده از 'warn' برای کاهش حجم لاگ
LOG_LEVEL=warn

# غیرفعال در production
DEBUG_CONSOLE=false
LOG_LEGACY=false

# =============================================================================
# 🔒 RATE LIMITING (Optional Overrides)
# =============================================================================
# به میلی‌ثانیه - 15 دقیقه پیش‌فرض
# RATE_LIMIT_WINDOW_MS=900000
# حداکثر درخواست در هر window
# RATE_LIMIT_MAX=100
